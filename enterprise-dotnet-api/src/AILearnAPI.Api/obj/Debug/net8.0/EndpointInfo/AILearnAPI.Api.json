    "/api/learn/{topic}": {
      "get": {
        "tags": [
          "Learn"
        ],
        "summary": "Quick learn with defaults",
        "description": "Simplified endpoint for generating learning content with default settings. Automatically includes 3 examples and 5 practice questions. Use URL encoding for topics with spaces (e.g., 'Azure%20Virtual%20Machines').",
