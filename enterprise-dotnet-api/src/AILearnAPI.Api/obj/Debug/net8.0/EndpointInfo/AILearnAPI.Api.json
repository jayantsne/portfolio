    "/api/ai/understand": {
      "post": {
        "tags": [
          "AI Understanding"
        ],
        "summary": "Understand exam topic with AI",
        "description": "Generates a comprehensive, structured explanation for Azure exam topics. Includes simple explanations, real-world examples, exam tips, common mistakes, and practice questions. Uses pre-defined prompts from database optimized for exam preparation. Typical response time: 5-10 seconds depending on topic complexity.",
        "operationId": "GetAiUnderstanding",
        "requestBody": {
          "description": "Understanding request with topic and exam code",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UnderstandRequestDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UnderstandRequestDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UnderstandRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "AI explanation generated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnderstandResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request - check topic name and exam code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "408": {
            "description": "Request timeout - AI service took too long",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "AiUnderstand"
        ],
        "summary": "Quick topic understanding (GET)",
        "description": "Simplified GET endpoint for quick AI explanations. Use query parameters for topic and exam code.",
        "operationId": "GetAiUnderstandingQuick",
        "parameters": [
          {
            "name": "topicName",
            "in": "query",
            "description": "Topic name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "examCode",
            "in": "query",
            "description": "Exam code (default: AI-102)",
            "schema": {
              "type": "string",
              "default": "AI-102"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnderstandResponseDto"
                }
              }
            }
          }
        }
      }
    },
