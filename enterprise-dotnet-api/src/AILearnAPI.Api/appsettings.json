{
  "ConnectionStrings": {
    "MongoDB": "",
    "Redis": "localhost:6379"
  },
  "MongoDB": {
    "DatabaseName": "jayant-portfolio"
  },
  "MongoDbSettings": {
    "ConnectionString": "",
    "DatabaseName": "jayant-portfolio"
  },
  "OllamaSettings": {
    "BaseUrl": "http://127.0.0.1:11434",
    "Model": "llama3:latest",
    "BackupModel": "qwen2.5:3b",
    "TimeoutSeconds": 300,
    "MaxTokens": 2400,
    "MaxConcurrentRequests": 3
  },
  "ApiSettings": {
    "ApiKey": "",
    "RateLimitPerMinute": 30
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "AILearnAPI",
    "Audience": "AILearnAPI",
    "ExpiryHours": 168
  },
  "Firebase": {
    "ProjectId": "myportfolioadmin"
  },
  "LlmProvider": {
    "EncryptionKey": ""
  },
  "LlmProviders": {
    "OpenAI": {
      "DefaultModel": "gpt-4o",
      "EmbeddingModel": "text-embedding-3-small",
      "Temperature": 0.7
    }
  },
  "Razorpay": {
    "KeyId":     "",
    "KeySecret": ""
  },
  "Subscription": {
    "TrialDays":       2,
    "MonthlyPriceINR": 199
  },
  "Redis": {
    "Enabled": false,
    "DefaultCacheDurationMinutes": 60,
    "QuestionsCacheDurationMinutes": 120,
    "ProgressCacheDurationMinutes": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/ailearnapi-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName"]
  },
  "Deployment": {
    "BackendScript":  "/opt/deploy/deploy-backend.sh",
    "FrontendScript": "/opt/deploy/deploy-frontend.sh"
  },
  "Judge0": {
    "Mode": "self-hosted",
    "SelfHostedUrl": "http://76.13.244.113:2358",
    "BaseUrl": "https://judge0-ce.p.rapidapi.com",
    "RapidApiHost": "judge0-ce.p.rapidapi.com",
    "RapidApiKey": "",
    "TimeoutSeconds": 30,
    "WaitBetweenPollMs": 500,
    "MaxPollAttempts": 20
  },
  "AllowedHosts": "*"
}
