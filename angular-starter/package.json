{
  "name": "angular-starter",
  "version": "0.0.2",
  "description": "The Angular starter / boilerplate project to start a new enterprise project",
  "author": "Wilfried Lucha <wilfried@lucha.at>",
  "homepage": "https://lucha.at",
  "license": "MIT",
  "repository": "https://github.com/jayantbhardwaj199/MyPortfolio",
  "scripts": {
    "start": "ng serve",
    "build": "ng build --configuration production",
    "build:secure": "ng build --configuration production && node scripts/obfuscate.mjs",
    "obfuscate": "node scripts/obfuscate.mjs",
    "test": "jest",
    "lint": "ng lint",
    "e2e": "testcafe chrome ./e2e/",
    "compodoc": "npx compodoc -p tsconfig.doc.json",
    "audit": "npm audit fix",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "deploy": "powershell -ExecutionPolicy Bypass -File ../deploy.ps1",
    "deploy:fe": "powershell -ExecutionPolicy Bypass -File ../deploy.ps1 -Frontend",
    "deploy:be": "powershell -ExecutionPolicy Bypass -File ../deploy.ps1 -Backend",
    "deploy:fast": "powershell -ExecutionPolicy Bypass -File ../deploy.ps1 -SkipBuild",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "firebase:local": "firebase emulators:start",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android",
    "android:apk": "powershell -ExecutionPolicy Bypass -File ../publish-android-release.ps1",
    "android:aab": "npm run android:sync && cd android && .\\gradlew.bat bundleRelease",
    "android:publish": "powershell -ExecutionPolicy Bypass -File ../publish-android-release.ps1"
  },
  "dependencies": {
    "@angular/animations": "^13.2.5",
    "@angular/cdk": "^13.2.5",
    "@angular/common": "^13.2.5",
    "@angular/compiler": "^13.2.5",
    "@angular/core": "^13.2.5",
    "@angular/forms": "^13.2.5",
    "@angular/material": "^13.2.5",
    "@angular/platform-browser": "^13.2.5",
    "@angular/platform-browser-dynamic": "^13.2.5",
    "@angular/router": "^13.2.5",
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/device": "^8.0.3",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@ngneat/transloco": "^3.1.1",
    "@tiptap/core": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "bcryptjs": "^3.0.3",
    "firebase": "^9.6.8",
    "highlight.js": "^11.11.1",
    "mongoose": "^9.1.4",
    "ngx-scrollbar": "^9.0.2",
    "nodemailer": "^6.7.2",
    "rxjs": "^6.6.7",
    "smooth-scrollbar": "^8.7.4",
    "tslib": "^2.0.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^13.1.0",
    "@angular-devkit/build-angular": "^13.2.5",
    "@angular-eslint/builder": "13.0.1",
    "@angular-eslint/eslint-plugin": "13.0.1",
    "@angular/cli": "13.2.5",
    "@angular/compiler-cli": "^13.2.5",
    "@compodoc/compodoc": "^1.1.16",
    "@types/jest": "^27.5.2",
    "auditjs": "^4.0.33",
    "auto-changelog": "^2.3.0",
    "javascript-obfuscator": "^4.2.2",
    "jest": "^27.4.5",
    "jest-junit": "^17.0.0",
    "jest-preset-angular": "^11.1.2",
    "prettier": "^2.5.1",
    "typescript": "~4.5.5",
    "webpack-bundle-analyzer": "^3.7.0"
  }
}
