[Unit]
Description=AI Learn API - ASP.NET Core Application
Documentation=https://github.com/yourusername/jayant-angular-ui
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/www/learnwithai.tech/backend
ExecStartPre=-/usr/bin/fuser -k 5000/tcp
ExecStart=/usr/bin/dotnet /var/www/learnwithai.tech/backend/AILearnAPI.Api.dll

# Restart policy
Restart=always
RestartSec=10
KillSignal=SIGINT

# Logging
SyslogIdentifier=ailearnapi
StandardOutput=journal
StandardError=journal

# Environment Variables
EnvironmentFile=/etc/ailearnapi.env

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Resource limits
LimitNOFILE=65536
TasksMax=4096

[Install]
WantedBy=multi-user.target
